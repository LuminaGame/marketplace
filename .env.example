# Copy to .env (gitignored) and fill in. `docker compose up --build` reads .env
# automatically; for `dart run bin/server.dart` export the variables yourself
# (e.g. `set -a; . ./.env; set +a` in bash).

# Required: HS256 key for access tokens (also salts stored IP hashes), at
# least 32 random characters. Generate one with: openssl rand -hex 32
MARKETPLACE_JWT_SECRET=

# Optional: passwords of the seeded `lumina` (admin) and `moderator` accounts
# when the server starts with --seed. Left unset, random ones are generated and
# printed once in the `seed accounts` log line.
# MARKETPLACE_SEED_ADMIN_PASSWORD=
# MARKETPLACE_SEED_MODERATOR_PASSWORD=

# Optional (docker compose): host folder with the shared test assets mounted
# for the seed. Defaults to ./test-assets.
# LUMINA_TEST_ASSETS=./test-assets
